NEXT_PUBLIC_APP_MODE=mock
APP_BASE_URL=http://localhost:3000

# PostgreSQL is server-only. Railway injects a private connection string in
# production; use a separate logical database and restricted application role.
DATABASE_URL=
DATABASE_POOL_MAX=10

# Portal signed launch and module-local session
PORTAL_MODULE_LAUNCH_SECRET=
PORTAL_LAUNCH_ISSUER=https://portal.raidguild.org
PORTAL_LAUNCH_AUDIENCE=portal-participation
PORTAL_MODULE_SLUG=portal-participation
# Enable only after the matching Portal module disclosure flags are deployed.
PORTAL_CREDENTIAL_CLAIMS_ENABLED=false
PORTAL_WALLET_CLAIMS_ENABLED=false
SESSION_SECRET=
SESSION_TTL_SECONDS=28800

# Server-to-server entitlement API. Generate independently per environment.
# Never expose this value through a NEXT_PUBLIC_ variable.
ENTITLEMENTS_SERVICE_KEY=

# Launch rail. A provider-neutral card adapter is retained for a later phase.
PAYMENT_ADAPTERS=gnosis-wxdai-direct

# Direct stablecoin rail
GNOSIS_CHAIN_RPC_URL=https://rpc.gnosischain.com
GNOSIS_PAYMENT_CONFIRMATIONS=12
GNOSIS_DAO_ADDRESS=0xf02fd4286917270cb94fbc13a0f4e1ed76f7e986
GNOSIS_RG_SHARES_ADDRESS=0x372fc5a6b0B12aE174F09f6Fc849A83dE6b503B6
GNOSIS_MEMBERSHIP_CONFIRMATIONS=12
RG_MEMBERSHIP_THRESHOLD=100
GNOSIS_TREASURY_ADDRESS=0x181eBDB03cb4b54F4020622F1B0EAcd67A8C63aC
GNOSIS_WXDAI_ADDRESS=0xe91D153E0b41518A2Ce8Dd3D7944Fa863463a97d

# Provider-specific secrets are added only when an adapter is selected.
